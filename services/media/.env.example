# ─── SERVICE CONFIGURATION EXAMPLE ───────────────────────────────────────────
# Media Microservice: Port 8002
# ─────────────────────────────────────────────────────────────────────────────

PORT=8002
NODE_ENV=development

# MongoDB connection string for media_db
# Local Native Dev: mongodb://admin:admin_secret_change_me@localhost:27017/media_db?authSource=admin
# Docker / Prod:   mongodb://admin:admin_secret_change_me@vibegrid_mongo:27017/media_db?authSource=admin
MONGO_DB_NAME=media_db
MONGO_URI=mongodb://admin:admin_secret_change_me@localhost:27017/media_db?authSource=admin

# MinIO S3 Object Storage
MINIO_INTERNAL_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_USER=minioadmin
MINIO_PASS=minioadmin_secret_change_me
MINIO_BUCKET=vibegrid-media

# RS256 JWT Public Key path
JWT_PUBLIC_KEY_PATH=../auth/secrets/jwt.public.key
