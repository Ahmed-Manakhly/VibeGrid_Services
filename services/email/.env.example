# ─── SERVICE CONFIGURATION EXAMPLE ───────────────────────────────────────────
# Email Worker Microservice: Port 8003
# ─────────────────────────────────────────────────────────────────────────────

PORT=8003
NODE_ENV=development

# RabbitMQ AMQP connection string
# Local Native Dev: amqp://vibegrid:rabbitmq_secret_change_me@localhost:5672
# Docker / Prod:   amqp://vibegrid:rabbitmq_secret_change_me@vibegrid_rabbitmq:5672
RABBITMQ_URL=amqp://vibegrid:rabbitmq_secret_change_me@localhost:5672

# Redis connection string (for email idempotency)
# Local Native Dev: redis://:redis_secret_change_me@localhost:6379
# Docker / Prod:   redis://:redis_secret_change_me@vibegrid_redis:6379
REDIS_URL=redis://:redis_secret_change_me@localhost:6379

# SMTP Email configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="VibeGrid Support <noreply@vibegrid.local>"
