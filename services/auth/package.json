{
  "name": "@vibegrid/auth-service",
  "version": "1.0.0",
  "description": "VibeGrid Express Auth Microservice (JWT + OAuth 2.0)",
  "main": "dist/interface/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/interface/main.js",
    "dev": "ts-node-dev --respawn --transpile-only src/interface/main.ts",
    "gen-keys": "bash scripts/gen-keys.sh"
  },
  "dependencies": {
    "argon2": "^0.31.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.2.1",
    "amqplib": "^0.10.3"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.24",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
