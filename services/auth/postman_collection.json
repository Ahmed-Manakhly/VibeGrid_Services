    {
      "name": "🌐 Via API Gateway (port 8000)",
      "description": "Test requests routed through the Nginx API Gateway. Requires gateway to be running.",
      "item": [
        {
          "name": "Gateway Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{GATEWAY_URL}}/health", "host": ["{{GATEWAY_URL}}"], "path": ["health"] },
            "description": "Verify the Nginx API Gateway is alive and routing correctly."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login via Gateway",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{ADMIN_EMAIL}}\",\n  \"password\": \"{{ADMIN_PASSWORD}}\"\n}"
            },
            "url": { "raw": "{{GATEWAY_URL}}/api/auth/login", "host": ["{{GATEWAY_URL}}"], "path": ["api", "auth", "login"] },
            "description": "Tests that the Nginx gateway correctly proxies login to the Auth Service."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
