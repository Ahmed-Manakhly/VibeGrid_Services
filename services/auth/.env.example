# ─── SERVICE CONFIGURATION EXAMPLE ───────────────────────────────────────────
# Copy this file to .env and adjust variables as needed.
# ─────────────────────────────────────────────────────────────────────────────

PORT=8001
NODE_ENV=development

# MongoDB connection string
# Local Native Dev: mongodb://admin:admin_secret_change_me@localhost:27017/auth_db?authSource=admin
# Docker / Prod:   mongodb://admin:admin_secret_change_me@vibegrid_mongo:27017/auth_db?authSource=admin
MONGO_DB_NAME=auth_db
MONGO_URI=mongodb://admin:admin_secret_change_me@localhost:27017/auth_db?authSource=admin

# RabbitMQ AMQP connection string
# Local Native Dev: amqp://vibegrid:rabbitmq_secret_change_me@localhost:5672
# Docker / Prod:   amqp://vibegrid:rabbitmq_secret_change_me@vibegrid_rabbitmq:5672
RABBITMQ_URL=amqp://vibegrid:rabbitmq_secret_change_me@localhost:5672

# RS256 JWT Keys (generate once via: bash services/auth/scripts/gen-keys.sh)
JWT_PRIVATE_KEY_PATH=./secrets/jwt.private.key
JWT_PUBLIC_KEY_PATH=./secrets/jwt.public.key

# Cookie settings for local dev
COOKIE_DOMAIN=localhost

