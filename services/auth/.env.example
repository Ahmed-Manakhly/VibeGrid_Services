# ─── LOCAL NATIVE DEV ────────────────────────────────────────────────────────
# Use this when running 'npm run dev' natively on host.
# Databases run in Docker via infrastructure/start-db-only.dev.sh
# ─────────────────────────────────────────────────────────────────────────────

PORT=3001
NODE_ENV=development

# MongoDB: use localhost because DB runs in Docker, app runs on host
MONGO_URI=mongodb://admin:admin_secret@localhost:27017/auth_db?authSource=admin

# RabbitMQ: use localhost
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# RS256 JWT Keys (generate once via: bash services/auth/scripts/gen-keys.sh)
JWT_PRIVATE_KEY_PATH=./secrets/jwt.private.key
JWT_PUBLIC_KEY_PATH=./secrets/jwt.public.key

# Cookie settings for local dev
COOKIE_DOMAIN=localhost

# SMTP (for OTP emails — use Gmail app password or Mailtrap for local testing)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=VibeGrid <noreply@vibegrid.local>
