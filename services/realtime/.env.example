# ─── SERVICE CONFIGURATION EXAMPLE ───────────────────────────────────────────
# Realtime Microservice: Port 8005
# ─────────────────────────────────────────────────────────────────────────────

PORT=8005
NODE_ENV=development

# Redis connection string
# Local Native Dev: redis://:redis_secret_change_me@localhost:6379
# Docker / Prod:   redis://:redis_secret_change_me@vibegrid_redis:6379
REDIS_URL=redis://:redis_secret_change_me@localhost:6379

# RS256 JWT Public Key path
JWT_PUBLIC_KEY_PATH=../auth/secrets/jwt.public.key

# Allowed Origins for CORS / WebSockets
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://vibegrid.manakhly.tech"
