# ─── MICROSERVICE DEFAULT PORTS ────────────────────────────────
AUTH_PORT=8001
MEDIA_PORT=8002
EMAIL_PORT=8003
ONBOARDING_PORT=8004
REALTIME_PORT=8005

# ─── AUTH MICROSERVICE CONFIG ─────────────────────────────────
JWT_PRIVATE_KEY_PATH=./secrets/jwt.private.key
JWT_PUBLIC_KEY_PATH=./secrets/jwt.public.key

# ─── EMAIL MICROSERVICE (SMTP) ─────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS="your_app_password"
EMAIL_FROM="VibeGrid Support <your_email@gmail.com>"

# ─── BOOTSTRAP ACCOUNTS ─────────────────────────────────────────
ADMIN_EMAIL=admin@vibegrid.manakhly.tech
ADMIN_PASSWORD="Admin_Password_ChangeMe2026"
ADMIN_NAME="VibeGrid Admin"
DEV_USER_EMAIL=dev@vibegrid.manakhly.tech
DEV_USER_PASSWORD="Dev_Password_ChangeMe2026"
DEV_USER_NAME="VibeGrid Developer"
FIXED_SEED_OTP=121212

# ─── OAUTH CONFIGURATION (Google & GitHub) ──────────────────────
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI_DEV="http://localhost:3000/api/auth/oauth/google/callback"
GOOGLE_REDIRECT_URI_PROD="https://vibegrid.manakhly.tech/api/auth/oauth/google/callback"

GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_REDIRECT_URI_DEV="http://localhost:3000/api/auth/oauth/github/callback"
GITHUB_REDIRECT_URI_PROD="https://vibegrid.manakhly.tech/api/auth/oauth/github/callback"

# ─── GLOBAL / GENERAL ─────────────────────────────────────────
NODE_ENV=development
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000,http://localhost:8001,http://vibegrid.manakhly.tech,https://vibegrid.manakhly.tech"
FRONTEND_DOMAIN=http://localhost:3000
COOKIE_DOMAIN=localhost

# ─── INFRASTRUCTURE DATABASES & BROKERS ───────────────────────
# PostgreSQL
POSTGRES_USER=vibegrid
POSTGRES_PASSWORD="vibegrid_postgres_secret_change_me"
POSTGRES_DB=vibegrid_db
PGDATA=/var/lib/postgresql/data

# MongoDB
MONGO_USER=admin
MONGO_PASSWORD="vibegrid_mongo_secret_change_me"
MONGO_AUTH_DB=auth_db
MONGO_MEDIA_DB=media_db

# Redis
REDIS_PASSWORD="vibegrid_redis_secret_change_me"

# RabbitMQ
RABBITMQ_USER=vibegrid
RABBITMQ_PASS="vibegrid_rabbitmq_secret_change_me"

# MinIO
MINIO_USER=minioadmin
MINIO_PASS="vibegrid_minio_secret_change_me"
