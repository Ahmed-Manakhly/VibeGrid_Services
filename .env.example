# ─── GLOBAL / GENERAL ─────────────────────────────────────────
NODE_ENV=production
ALLOWED_ORIGINS=https://vibegrid.manakhly.tech
FRONTEND_DOMAIN=https://vibegrid.manakhly.tech
COOKIE_DOMAIN=vibegrid.manakhly.tech

# ─── INFRASTRUCTURE DATABASES & BROKERS ───────────────────────
# PostgreSQL
POSTGRES_USER=vibegrid
POSTGRES_PASSWORD=vibegrid_secret_change_me
POSTGRES_DB=vibegrid_db
PGDATA=/var/lib/postgresql/data

# MongoDB
MONGO_USER=admin
MONGO_PASSWORD=admin_secret_change_me
MONGO_AUTH_DB=auth_db
MONGO_MEDIA_DB=media_db

# Redis
REDIS_PASSWORD=redis_secret_change_me

# RabbitMQ
RABBITMQ_USER=vibegrid
RABBITMQ_PASS=rabbitmq_secret_change_me

# MinIO
MINIO_USER=minioadmin
MINIO_PASS=minioadmin_secret_change_me

# ─── AUTH MICROSERVICE ────────────────────────────────────────
PORT=3001
JWT_PRIVATE_KEY_PATH=/app/secrets/jwt.private.key
JWT_PUBLIC_KEY_PATH=/app/secrets/jwt.public.key

# SMTP Email (Outlook / Office365 or custom host)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_email_password_here
EMAIL_FROM="VibeGrid" <noreply@yourdomain.com>
