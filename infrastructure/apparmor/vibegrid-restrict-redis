#include <tunables/global>

# Redis AppArmor Profile for VibeGrid
profile vibegrid-restrict-redis flags=(attach_disconnected, mediate_deleted) {
    include <abstractions/base>
    include <abstractions/nameservice>

    /bin/** rix,
    /usr/bin/** rix,
    /usr/local/bin/** rix,
    /sbin/** rix,
    /usr/sbin/** rix,
    /lib/** rm,
    /usr/lib/** rm,
    /usr/local/lib/** rm,
    /lib64/** rm,

    /** rwmkl,
    / rw,
    / m,

    capability,
    deny capability sys_admin,

    network inet stream,
    network inet6 stream,
    network inet dgram,
    network inet6 dgram,
    network unix stream,
    network unix dgram,

    @{PROC}/** rw,
    /sys/** r,

    signal,
    ptrace,

    deny @{PROC}/docker*/cmdline w,
    deny @{PROC}/docker*/fd/** w,
}
