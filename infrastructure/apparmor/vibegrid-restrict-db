#include <tunables/global>

# VibeGrid DB AppArmor Profile (PostgreSQL / MongoDB / Redis / RabbitMQ)
profile vibegrid-restrict-db flags=(attach_disconnected, mediate_deleted) {
    include <abstractions/base>
    include <abstractions/nameservice>

    # Allow system binaries for database engines
    /bin/** rix,
    /usr/bin/** rix,
    /usr/local/bin/** rix,
    /sbin/** rix,
    /usr/sbin/** rix,
    /lib/** rm,
    /usr/lib/** rm,
    /usr/local/lib/** rm,

    # Allow database storage volume access
    /** rwmkl,

    # Network access
    network inet stream,
    network inet6 stream,
    network inet dgram,
    network inet6 dgram,
    network unix stream,
    network unix dgram,

    # Process signals
    signal,
    ptrace,

    capability,
    deny capability sys_admin,
}
