#include <tunables/global>

# MinIO AppArmor Profile for VibeGrid Storage
profile vibegrid-restrict-minio flags=(attach_disconnected, mediate_deleted) {
    include <abstractions/base>
    include <abstractions/nameservice>

    # Allow system binaries for MinIO executable
    /bin/** rix,
    /usr/bin/** rix,
    /usr/local/bin/** rix,
    /sbin/** rix,
    /usr/sbin/** rix,
    /lib/** rm,
    /usr/lib/** rm,
    /usr/local/lib/** rm,
    /lib64/** rm,

    # Allow storage volume access for uploads & object data
    /** rwmkl,
    / rw,
    / m,

    # Shell interpreters for entrypoint scripting
    /bin/sh ix,
    /bin/bash ix,

    # Capabilities (deny sys_admin for container isolation)
    capability,
    deny capability sys_admin,

    # Network access for S3 API & Console (ports 9000/9001)
    network inet stream,
    network inet6 stream,
    network inet dgram,
    network inet6 dgram,
    network unix stream,
    network unix dgram,

    # Process signals
    signal,
    ptrace,

    # Deny dangerous system mounts
    deny @{PROC}/docker*/cmdline w,
    deny @{PROC}/docker*/fd/** w,
}
