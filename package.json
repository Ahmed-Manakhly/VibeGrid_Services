{
  "name": "vibegrid-services",
  "version": "1.0.0",
  "description": "Backend microservices and worker pool for VibeGrid distributed system architecture",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npx pnpm -r build",
    "typecheck": "npx pnpm -r typecheck",
    "test": "npx pnpm -r test",
    "infra:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker-compose.yml down",
    "infra:logs": "docker compose -f infrastructure/docker-compose.yml logs -f",
    "infra:ps": "docker compose -f infrastructure/docker-compose.yml ps",
    "clean:auth-mongo": "node services/auth/scripts/clean_mongo.js",
    "clean:auth-mongo:all": "node services/auth/scripts/clean_mongo.js --include-admins",
    "clean:media-mongo": "node services/media/scripts/clean_media_mongo.js",
    "clean:mongo:all": "node services/auth/scripts/clean_mongo.js --include-admins && node services/media/scripts/clean_media_mongo.js",
    "dev:auth": "npx pnpm --filter @vibegrid/auth-service dev",
    "dev:media": "npx pnpm --filter @vibegrid/media-service dev",
    "dev:email": "npx pnpm --filter @vibegrid/email-worker dev",
    "dev:onboarding": "npx pnpm --filter @vibegrid/onboarding-worker dev",
    "dev:realtime": "npx pnpm --filter @vibegrid/realtime-service dev"
  },
  "keywords": [
    "vibegrid",
    "microservices",
    "rabbitmq",
    "redis",
    "mongodb",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2"
  }
}
