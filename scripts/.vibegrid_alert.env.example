# VibeGrid Health Monitoring & Alerting Environment Configuration
# Copy this file to $HOME/.vibegrid_alert.env or VibeGrid_Services/scripts/.vibegrid_alert.env

# Webhook Alerts (Slack / Discord)
ALERT_WEBHOOK_URL="https://discord.com/api/webhooks/your-webhook-id/your-webhook-token"

# Telegram Bot Alerts
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"
TELEGRAM_CHAT_ID="-1001234567890"

# Service Endpoints Overrides (Optional)
BFF_URL="http://localhost:3000/api/health"
GATEWAY_URL="http://localhost:8000/health"
AUTH_URL="http://localhost:8001/health"
MEDIA_URL="http://localhost:3002/health"
EMAIL_URL="http://localhost:8003/health"
ONBOARDING_URL="http://localhost:8004/health"
REALTIME_URL="http://localhost:8005/health"

# Metric Alert Thresholds
PID_WARN=40
PID_CRIT=80
CPU_WARN=75
CPU_CRIT=90
MEM_WARN=75
MEM_CRIT=90

# Cron Job Example (Add to crontab -e on VPS):
# */2 * * * * /path/to/VibeGrid_Services/scripts/monitor-health.sh >> /tmp/vibegrid-cron.log 2>&1
